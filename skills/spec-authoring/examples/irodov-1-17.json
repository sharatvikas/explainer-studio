{
  "id": "irodov-1-17",
  "template": "worked-problem",
  "title": "Where to Leave the Road",
  "subtitle": "Irodov 1.17 · Fermat's principle",
  "kits": ["physics"],
  "thumbnail": {"lines": ["SHORTEST", "≠ FASTEST"], "badge": "IRODOV 1.17", "formula": "\\sin r=\\dfrac{1}{\\eta}"},
  "params": {"x": 1.42265, "a": 0},
  "stage": {"width": 10, "height": 6},
  "objects": [
    {"id": "field", "type": "region", "style": "grass", "corners": [[0.2, 1.0], [9.4, 1.0], [9.4, 4.85], [0.2, 4.85]]},
    {"id": "road", "type": "physics.road", "from": [0.2, 5.0], "to": [9.4, 5.0]},
    {"id": "A", "type": "point", "at": ["0.8 + a", 5.0], "label": "A", "label_dir": "ul"},
    {"id": "D", "type": "point", "at": [7.4, 5.0], "label": "D", "label_dir": "ur"},
    {"id": "B", "type": "point", "at": [7.4, 1.7], "label": "B", "label_dir": "down"},
    {"id": "C", "type": "point", "at": ["0.8 + 3.3*x", 5.0], "label": "C", "label_dir": "ul", "color": "accent"},
    {"id": "straight", "type": "segment", "from": "A", "to": "B", "color": "bad", "width": 4},
    {"id": "roadall", "type": "polyline", "path": ["A", "D", "B"], "color": "primary", "width": 4},
    {"id": "green", "type": "polyline", "path": ["A", "C", "B"], "color": "good", "width": 4},
    {"id": "perp", "type": "segment", "from": "D", "to": "B", "color": "muted", "width": 2, "dashed": true},
    {"id": "AC", "type": "segment", "from": "A", "to": "C", "color": "road", "width": 6},
    {"id": "CB", "type": "segment", "from": "C", "to": "B", "color": "field", "width": 6},
    {"id": "dimd", "type": "dimension", "from": "A", "to": "D", "label": "d", "side": "up", "offset": 0.6},
    {"id": "diml", "type": "dimension", "from": "D", "to": "B", "label": "\\ell", "side": "right", "offset": 0.5},
    {"id": "dimx", "type": "dimension", "from": "A", "to": "C", "label": "x", "side": "down", "offset": 0.45, "color": "road"},
    {"id": "vroad", "type": "label", "tex": "v", "at": [2.2, 5.0], "dir": "up", "offset": 0.3, "color": "road"},
    {"id": "vfield", "type": "label", "tex": "v/\\eta", "at": [3.0, 2.6], "color": "field", "size": 1.2},
    {"id": "normal", "type": "segment", "from": "C", "to": ["C.x", 1.9], "color": "ink", "width": 2, "dashed": true},
    {"id": "r", "type": "angle", "vertex": "C", "from_dir": [0, -1], "to": "B", "label": "r", "radius": 0.7},
    {"id": "med", "type": "physics.media", "boundary": 4.9, "top_label": "fast medium", "bottom_label": "slow medium (eta times slower)"},
    {"id": "ray", "type": "physics.ray", "path": ["A", "C", "B"]},
    {"id": "cd", "type": "brace", "from": "C", "to": "D", "label": "577 m", "plain": true, "side": "up", "offset": 0.25}
  ],
  "beats": [
    {"chapter": "The race", "say": "Three cars. Same start, same finish.",
     "do": [{"op": "camera", "focus": "stage", "zoom": 1.3}, {"op": "show", "ids": ["field", "road", "A", "B"], "sfx": "pop"}]},
    {"say": "Red cuts straight across the field. The shortest path there is.", "do": [{"op": "create", "ids": ["straight"], "for": 0.7}]},
    {"say": "Blue stays on the fast highway as long as it can, then turns.", "do": [{"op": "create", "ids": ["roadall"], "for": 0.7}]},
    {"say": "And green turns off somewhere in between.", "do": [{"op": "create", "ids": ["green"], "for": 0.7}]},
    {"say": "Which one gets there first?",
     "do": [{"op": "camera", "reset": true, "for": 0.5}, {"op": "fade", "ids": ["straight", "roadall", "green"], "to": 0.25, "for": 0.5},
            {"op": "race", "at": 0.5, "board": true, "seconds": 6.5, "routes": [
              {"color": "bad", "label": "Straight across", "path": ["A", "B"], "speeds": [1.65]},
              {"color": "primary", "label": "Road, then turn", "path": ["A", "D", "B"], "speeds": [3.3, 1.65]},
              {"color": "good", "label": "Turn off in between", "path": ["A", "C", "B"], "speeds": [3.3, 1.65]}]}]},
    {"say": "Green wins. Not the shortest path, and not the most road.", "do": [{"op": "highlight", "ids": ["green"], "color": "good"}]},
    {"say": "A ray of light crossing into glass picks exactly this path. By the end, you'll know why.",
     "do": [{"op": "flash", "ids": ["green"], "color": "accent", "sfx": "riser"}]},
    {"chapter": "Title", "say": "Where to leave the road. Irodov, problem one point one seven.", "do": [{"op": "title_card"}]},
    {"chapter": "The setup", "say": "You're at A on a straight highway, and you need to reach B, out in the field.",
     "do": [{"op": "hide", "ids": ["race", "straight", "roadall", "green"]}, {"op": "panel_clear"},
            {"op": "highlight", "ids": ["A"], "at": 0.3}, {"op": "highlight", "ids": ["B"], "at": 0.65}]},
    {"say": "On the road your car does v. On the rough field it manages only v over eta.",
     "do": [{"op": "write", "ids": ["vroad"]}, {"op": "write", "ids": ["vfield"], "at": 0.5}]},
    {"say": "Drop a perpendicular from B to the road. Its foot is D, a distance ell from B.",
     "do": [{"op": "create", "ids": ["perp"]}, {"op": "show", "ids": ["D", "diml"], "at": 0.5}]},
    {"say": "And D is a distance d along the road from A.", "do": [{"op": "show", "ids": ["dimd"]}]},
    {"say": "Now leave the road at a point C, a distance x from A.",
     "do": [{"op": "tween", "param": "x", "to": 0.9, "for": 0.2}, {"op": "show", "ids": ["C", "AC", "CB", "dimx"], "at": 0.25}]},
    {"chapter": "Two tempting answers", "say": "Tempting answer one: stay on the fast road all the way to D.",
     "do": [{"op": "tween", "param": "x", "to": 1.95}]},
    {"say": "Quick for as long as possible, then you crawl across the field at its widest.",
     "do": [{"op": "flash", "ids": ["CB"], "color": "bad", "at": 0.45}]},
    {"say": "Tempting answer two: head straight for B. The shortest route there is.",
     "do": [{"op": "tween", "param": "x", "to": 0.9, "for": 0.3}, {"op": "show", "ids": ["straight"], "at": 0.3}]},
    {"say": "But every metre of it is at the slow speed. The best route must be in between.",
     "do": [{"op": "highlight", "ids": ["vfield"], "color": "bad"}, {"op": "hide", "ids": ["straight"], "at": 0.6}]},
    {"chapter": "Try every turn-off", "say": "So let's try every turn-off, and plot the total time against x.",
     "do": [{"op": "tween", "param": "x", "to": 0.3, "for": 0.3},
            {"op": "graph", "id": "time", "fn": "x + 2*sqrt((2-x)**2+1)", "var": "x", "range": [0, 1.95], "trace": true, "x_label": "x", "y_label": "t", "at": 0.35}]},
    {"say": "Watch the time fall, bottom out, and climb again.", "do": [{"op": "tween", "param": "x", "to": 1.95, "rate": "linear"}]},
    {"say": "Let's park C right at the bottom of that curve.", "do": [{"op": "tween", "param": "x", "to": 1.42265, "for": 0.7, "sfx": "ding"}]},
    {"chapter": "The calculus", "say": "On the road, the time is x over v.",
     "do": [{"op": "panel_clear"}, {"op": "hide", "ids": ["vroad", "dimd", "diml"]}, {"op": "eq", "tex": "t_1=\\dfrac{x}{v}", "color": "road", "at": 0.2}]},
    {"say": "The field leg is a hypotenuse, covered eta times slower.",
     "do": [{"op": "highlight", "ids": ["CB"], "color": "field"}, {"op": "eq", "tex": "t_2=\\dfrac{\\eta\\sqrt{(d-x)^2+\\ell^2}}{v}", "color": "field", "at": 0.3}]},
    {"say": "At the minimum the slope is zero, so differentiate and set it equal to zero.",
     "do": [{"op": "eq", "tex": "\\dfrac{dt}{dx}=\\dfrac{1}{v}\\left[1-\\dfrac{\\eta(d-x)}{\\sqrt{(d-x)^2+\\ell^2}}\\right]=0", "size": 1.05}]},
    {"say": "Square both sides, and gather up the d minus x terms.", "do": [{"op": "eq", "tex": "(\\eta^2-1)(d-x)^2=\\ell^2"}]},
    {"say": "And there's the answer.", "do": [{"op": "eq", "tex": "CD=d-x=\\dfrac{\\ell}{\\sqrt{\\eta^2-1}}", "color": "accent", "box": true, "sfx": "ding"}]},
    {"chapter": "The missing d", "say": "Look closely. There is no d anywhere in that answer.",
     "do": [{"op": "callout", "text": "No d anywhere!", "color": "bad", "at": 0.3}]},
    {"say": "Start further back, or closer to D, and you still turn off at the very same spot.",
     "do": [{"op": "tween", "param": "a", "to": -0.5, "for": 0.3}, {"op": "tween", "param": "a", "to": 2.0, "at": 0.35, "for": 0.35}, {"op": "tween", "param": "a", "to": 0, "at": 0.75, "for": 0.25}]},
    {"chapter": "Snell's law", "say": "Now measure the angle r between the field leg and the perpendicular to the road.",
     "do": [{"op": "create", "ids": ["normal"], "at": 0.3}, {"op": "show", "ids": ["r"], "at": 0.6}]},
    {"say": "Its sine is CD over CB, which is exactly one over eta.",
     "do": [{"op": "panel_clear"}, {"op": "eq", "tex": "\\sin r=\\dfrac{CD}{CB}=\\dfrac{1}{\\eta}", "color": "accent", "size": 1.5, "at": 0.15}]},
    {"say": "That's Snell's law.", "do": [{"op": "reveal", "text": "That's Snell's law."}]},
    {"say": "Treat the road as a fast medium for light, and the field as a slow one.",
     "do": [{"op": "hide", "ids": ["vroad", "vfield", "dimx", "dimd", "AC", "CB"]}, {"op": "show", "ids": ["med"], "at": 0.3},
            {"op": "show", "ids": ["A", "B", "C", "D", "normal", "r"], "at": 0.6}]},
    {"say": "A ray grazing along the boundary bends in at exactly this angle.", "do": [{"op": "create", "ids": ["ray"], "for": 0.7}]},
    {"say": "Light isn't doing calculus. It simply takes the quickest path. That's Fermat's principle.",
     "do": [{"op": "reveal", "text": "Fermat's principle", "at": 0.55}]},
    {"chapter": "Put numbers in", "say": "Let's put in numbers. Eta is two, ell is one kilometre, and d is two.",
     "do": [{"op": "hide", "ids": ["med", "ray", "normal", "r"]}, {"op": "panel_clear"},
            {"op": "eq", "tex": "\\eta=2,\\quad \\ell=1\\ \\mathrm{km},\\quad d=2\\ \\mathrm{km}", "size": 1.1, "at": 0.3}]},
    {"say": "So you should leave the road five hundred and seventy seven metres before D.",
     "do": [{"op": "show", "ids": ["cd"]}, {"op": "eq", "tex": "CD=\\dfrac{1}{\\sqrt{3}}\\ \\mathrm{km}\\approx 577\\ \\mathrm{m}", "color": "accent", "at": 0.3}]},
    {"say": "Rematch.",
     "do": [{"op": "panel_clear"}, {"op": "hide", "ids": ["cd", "perp", "diml"]}, {"op": "race", "board": true, "seconds": 7, "routes": [
       {"color": "bad", "label": "Straight across", "path": ["A", "B"], "speeds": [1.65]},
       {"color": "primary", "label": "Road to D, then turn", "path": ["A", "D", "B"], "speeds": [3.3, 1.65]},
       {"color": "good", "label": "Turn off at C", "path": ["A", "C", "B"], "speeds": [3.3, 1.65]}]}]},
    {"say": "Three point seven three minutes, against four, and four point four seven.",
     "do": [{"op": "callout", "text": "saves 0.74 min", "color": "good", "near": "C", "at": 0.5}]},
    {"chapter": "Your turn", "say": "Shortest isn't always fastest, and light has known that all along.",
     "do": [{"op": "panel_clear"}, {"op": "reveal", "text": "Shortest ≠ Fastest", "at": 0.2}]},
    {"say": "Your turn. What if the field were faster than the road? Tell me in the comments.",
     "do": [{"op": "callout", "text": "What if the field is faster?", "color": "field", "at": 0.3}]}
  ],
  "short": {"hook": ["WHICH CAR", "WINS?"], "beats": [0, 3, 4, 5, 24, 29], "cta": "Light takes the quickest path too. Full solution linked below."}
}
